# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vídeos grandes — hospedar no Supabase Storage ou CDN
public/rec/*.mp4
dev-out*.txt
dev-err*.txt
dev-server.log
.tmp/

# Playwright (Sprint QA Local 3.0.2) — traces/screenshots/videos/storageState
# live under .tmp/playwright/ (already covered above); these are defensive
# fallbacks in case a run ever writes to Playwright's own defaults.
/playwright-report/
/test-results/

# Project-scoped agent skills installed from audited external repositories
.agents/skills/gsap-*/
.agents/skills/threejs-*/
.claude/skills/gsap-*/
.claude/skills/threejs-*/
skills-lock.json

.vercel

# Sistema LKT — FORA do Git enquanto o repositório for público.
# Quando o repo estiver privado, trocar por: .claude/settings.local.json, /.lkt/backup/ e mídia de sistema-lkt.
/.claude/skills/
/.lkt/
/sistema-lkt/
.claude/settings.local.json
